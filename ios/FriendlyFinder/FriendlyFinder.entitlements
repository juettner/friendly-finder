<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The CarPlay "Driving Task" entitlement. The Simulator honours this as-is.
	  A real iPhone + head unit only honours it once Apple has granted the
	  entitlement to your developer account (the request you submitted).
	-->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
</dict>
</plist>
